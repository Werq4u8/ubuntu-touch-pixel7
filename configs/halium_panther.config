# ============================================================================
# Ubuntu Touch (Halium) + Waydroid + Wireless Kernel Fragment
# Device: Google Pixel 7 (panther) / Google Tensor G2 (gs201)
# Base Kernel: Linux 6.1.145 (android-gs-pantah-6.1 / GKI 2.0)
# ============================================================================

# --- 1. Systemd, Containers (LXC) & Namespaces ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y

# --- 2. Virtual Terminals & Console (Required by Lomiri / Mir / LightDM) ---
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_HW_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y

# --- 3. AppArmor LSM (Required by Ubuntu Touch Lomiri & Click Packages) ---
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,apparmor"

# --- 4. Filesystems for Slot-B Super SquashFS + OverlayFS Architecture ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# --- 5. USB Gadget (RNDIS / ECM for SSH over USB 10.15.19.82) ---
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=y

# --- 6. Wireless (Wi-Fi mac80211/cfg80211, Bridge/VETH for Waydroid) ---
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_MAC80211_INJECT=y
CONFIG_USB_RTL8150=n
